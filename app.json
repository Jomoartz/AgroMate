{
  "expo": {
    "name": "nso",
    "slug": "nso",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "default",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#e63c4b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/splash.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nso.app",
      "permissions": ["INTERNET"]
    },
    "web": {
      "favicon": "./app/assets/icon.png",
      "bundler": "metro"
    },
    "sdkVersion": "51.0.0",
    "extra": {
      }
    }  }

